# Postgres connection string. Locally, point this at a local Postgres or a
# Neon/Vercel Postgres dev branch. In Vercel's dashboard, connecting a
# Postgres storage integration sets POSTGRES_URL for you automatically —
# you shouldn't need to set this one manually in production.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/flora

PORT=4000

# Powers the arrangement assistant (/api/agent). Get a key at
# https://platform.claude.com — on Vercel, add it under Settings →
# Environment Variables. The rest of the app works without it.
ANTHROPIC_API_KEY=
